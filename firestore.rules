rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー: 自分自身のみ読み書き
    match /users/{uid} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /shops/{shopId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid
            == get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid;
      }

      // 店舗情報は公開読み取り（注文画面用）、書き込みはオーナーのみ
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicId is string
        && request.resource.data.name is string;
      allow update, delete: if isOwner();

      match /settings/{settingsId} {
        allow read: if true;
        allow create, update, delete: if isOwner();
      }

      match /menuGroups/{groupId} {
        allow read: if true;
        allow create, update, delete: if isOwner();
      }

      match /menus/{menuId} {
        allow read: if true;
        allow create, update, delete: if isOwner();
      }

      // 注文番号カウンタ: 未ログインの注文でも安全に増分できるよう専用ドキュメントへ分離
      match /counters/orders {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['lastOrderNo', 'updatedAt'])
          && request.resource.data.lastOrderNo is int
          && request.resource.data.lastOrderNo == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOrderNo', 'updatedAt'])
          && request.resource.data.lastOrderNo == resource.data.lastOrderNo + 1;
        allow delete: if false;
      }

      match /orders/{orderId} {
        // 注文は誰でも作成可（QR注文・未ログイン想定）。基本形のみ検証し、
        // アイテム個別の詳細検証は Cloud Functions 側で担保する
        allow create: if
          request.resource.data.keys().hasOnly(['tableId', 'orderNo', 'status', 'items', 'createdAt', 'updatedAt'])
          && request.resource.data.tableId is string
          && request.resource.data.tableId.size() > 0
          && request.resource.data.orderNo is int
          && request.resource.data.orderNo > 0
          && request.resource.data.status == 'received'
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 20;
        // 読み取り・ステータス更新はオーナーのみ
        allow read, update: if isOwner();
        allow delete: if false;
      }
    }
  }
}
