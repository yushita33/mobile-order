rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー: 自分自身のみ読み書き
    match /users/{uid} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /shops/{shopId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid
            == get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid;
      }

      // 店舗情報は公開読み取り（注文画面用）、書き込みはオーナーのみ
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.publicId is string
        && request.resource.data.name is string;
      allow update, delete: if isOwner();

      match /settings/{settingsId} {
        allow read: if true;
        allow create, update, delete: if isOwner();
      }

      match /menuGroups/{groupId} {
        allow read: if true;
        allow create, update, delete: if isOwner();
      }

      match /menus/{menuId} {
        allow read: if true;
        allow create, update, delete: if isOwner();
      }

      match /orders/{orderId} {
        // 注文は誰でも作成可（QR注文・未ログイン想定）だが、内容を厳格に検証
        allow create: if
          request.resource.data.keys().hasOnly(['tableId', 'orderNo', 'status', 'items', 'createdAt', 'updatedAt'])
          && request.resource.data.tableId is string
          && request.resource.data.tableId.size() > 0
          && request.resource.data.orderNo is int
          && request.resource.data.orderNo > 0
          && request.resource.data.status == 'received'
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 20
          && request.resource.data.items.all(item,
            item.menuId is string
            && item.name is string
            && item.price is int
            && item.price > 0
            && item.qty is int
            && item.qty >= 1
            && item.qty <= 99
            && item.menuVersion is int
            && item.menuVersion > 0);
        // 読み取り・ステータス更新はオーナーのみ
        allow read, update: if isOwner();
        allow delete: if false;
      }
    }
  }
}
