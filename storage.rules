rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // メニュー画像: 読み取りは公開、書き込みは店舗オーナーのみ
    match /shops/{shopId}/menus/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid
          == request.auth.uid;
    }
  }
}
